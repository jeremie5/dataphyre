[
    {
        "name": "message_normalize_cleans_addresses_and_metadata",
        "function": "normalize",
        "class": "Dataphyre\\Mailer\\Message",
        "static_method": true,
        "args": [
            {
                "from": "Support Team <support@example.com>",
                "replyTo": "Replies <reply@example.com>",
                "to": [
                    "Ada Lovelace <ada@example.com>",
                    "invalid"
                ],
                "cc": {
                    "ops@example.com": "Ops"
                },
                "bcc": false,
                "subject": "  Welcome  ",
                "html": "<p>Hello</p>",
                "text": "Hello",
                "headers": {
                    "X-Campaign": 123,
                    "": "ignored"
                },
                "categories": [
                    "onboarding",
                    ""
                ],
                "metadata": {
                    "campaign": "welcome"
                }
            }
        ],
        "expected": [
            {
                "assert": {
                    "type": "array",
                    "paths": {
                        "from/email": {
                            "same": "support@example.com"
                        },
                        "from/name": {
                            "same": "Support Team"
                        },
                        "reply_to/email": {
                            "same": "reply@example.com"
                        },
                        "reply_to/name": {
                            "same": "Replies"
                        },
                        "to": {
                            "same": [
                                {
                                    "email": "ada@example.com",
                                    "name": "Ada Lovelace"
                                }
                            ]
                        },
                        "cc": {
                            "same": [
                                {
                                    "email": "ops@example.com",
                                    "name": "Ops"
                                }
                            ]
                        },
                        "bcc": {
                            "same": []
                        },
                        "subject": {
                            "same": "Welcome"
                        },
                        "html": {
                            "same": "<p>Hello</p>"
                        },
                        "text": {
                            "same": "Hello"
                        },
                        "headers": {
                            "same": {
                                "X-Campaign": "123"
                            }
                        },
                        "attachments": {
                            "same": []
                        },
                        "tags": {
                            "same": [
                                "onboarding"
                            ]
                        },
                        "metadata": {
                            "same": {
                                "campaign": "welcome"
                            }
                        }
                    }
                }
            }
        ],
        "max_millis": 5,
        "file": {
            "runtime": "modules/mailer/Framework/Message.php"
        }
    },
    {
        "name": "message_normalize_builds_one_click_unsubscribe_headers",
        "function": "normalize",
        "class": "Dataphyre\\Mailer\\Message",
        "static_method": true,
        "args": [
            {
                "to": "subscriber@example.com",
                "unsubscribe": {
                    "url": "https://example.com/unsubscribe/abc",
                    "email": "unsubscribe@example.com",
                    "one_click": true
                }
            }
        ],
        "expected": [
            {
                "assert": {
                    "type": "array",
                    "paths": {
                        "from/email": {
                            "same": "no-reply@example.invalid"
                        },
                        "from/name": {
                            "same": "Dataphyre"
                        },
                        "reply_to": {
                            "exists": true,
                            "same": null
                        },
                        "to": {
                            "same": [
                                {
                                    "email": "subscriber@example.com",
                                    "name": ""
                                }
                            ]
                        },
                        "cc": {
                            "same": []
                        },
                        "bcc": {
                            "same": []
                        },
                        "subject": {
                            "same": ""
                        },
                        "html": {
                            "same": ""
                        },
                        "text": {
                            "same": ""
                        },
                        "headers": {
                            "same": {
                                "List-Unsubscribe": "<https://example.com/unsubscribe/abc>, <mailto:unsubscribe@example.com>",
                                "List-Unsubscribe-Post": "List-Unsubscribe=One-Click"
                            }
                        },
                        "attachments": {
                            "same": []
                        },
                        "tags": {
                            "same": []
                        },
                        "metadata": {
                            "same": []
                        }
                    }
                }
            }
        ],
        "max_millis": 5,
        "file": {
            "runtime": "modules/mailer/Framework/Message.php"
        }
    }
]
