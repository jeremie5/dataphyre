[
    {
        "name": "simulate_reports_granted_and_denied_deltas",
        "function": "simulate",
        "class": "dataphyre\\permission",
        "static_method": true,
        "args": [
            {
                "permissions": [
                    "panel.orders.view_any"
                ]
            },
            {
                "grant": [
                    "panel.orders.update"
                ],
                "deny": [
                    "panel.orders.force_delete"
                ]
            },
            [
                "panel.orders.view_any",
                "panel.orders.update",
                "panel.orders.force_delete"
            ]
        ],
        "expected": {
            "assert": {
                "type": "array",
                "paths": {
                    "after/panel.orders.update": {
                        "same": true
                    },
                    "after/panel.orders.force_delete": {
                        "same": false
                    },
                    "delta/granted": {
                        "contains": [
                            "panel.orders.update"
                        ]
                    }
                }
            }
        },
        "max_millis": 50,
        "file": {
            "module": "permission"
        }
    }
]
