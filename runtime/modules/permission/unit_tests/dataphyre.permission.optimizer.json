[
    {
        "name": "optimize_rules_removes_shadowed_grants_but_keeps_denies",
        "function": "optimizeRules",
        "class": "dataphyre\\permission",
        "static_method": true,
        "args": [
            [
                "panel.orders.*",
                "panel.orders.view_any",
                "panel.orders.update",
                "-panel.orders.force_delete"
            ]
        ],
        "expected": {
            "assert": {
                "type": "array",
                "contains": [
                    "panel.orders.*",
                    "-panel.orders.force_delete"
                ],
                "not_contains": [
                    "panel.orders.update"
                ]
            }
        },
        "max_millis": 50,
        "file": {
            "module": "permission"
        }
    },
    {
        "name": "analyze_rules_reports_conflicts_and_shadowed_rules",
        "function": "analyzeRules",
        "class": "dataphyre\\permission",
        "static_method": true,
        "args": [
            [
                "panel.orders.*",
                "panel.orders.update",
                "panel.orders.update",
                "-panel.orders.update"
            ]
        ],
        "expected": {
            "assert": {
                "type": "array",
                "paths": {
                    "ok": {
                        "same": false
                    },
                    "removed": {
                        "contains": [
                            "panel.orders.update"
                        ]
                    },
                    "findings": {
                        "some": {
                            "paths": {
                                "type": {
                                    "same": "conflicting_rule"
                                }
                            }
                        }
                    }
                }
            }
        },
        "max_millis": 50,
        "file": {
            "module": "permission"
        }
    }
]
