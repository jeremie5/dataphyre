[
    {
        "name": "manifest_without_panel_returns_module_metadata",
        "function": "manifest",
        "class": "dataphyre\\permission",
        "static_method": true,
        "args": [
            null,
            {
                "include_audit": false,
                "include_roles": false
            }
        ],
        "expected": {
            "assert": {
                "type": "array",
                "paths": {
                    "module": {
                        "same": "dataphyre.permission"
                    },
                    "version": {
                        "same": 1
                    }
                }
            }
        },
        "max_millis": 50,
        "file": {
            "module": "permission"
        }
    },
    {
        "name": "diff_manifests_reports_added_role",
        "function": "diffManifests",
        "class": "dataphyre\\permission",
        "static_method": true,
        "args": [
            {
                "roles": []
            },
            {
                "roles": {
                    "viewer": [
                        "panel.orders.view"
                    ]
                }
            }
        ],
        "expected": {
            "assert": {
                "type": "array",
                "paths": {
                    "roles/added": {
                        "same": [
                            "viewer"
                        ]
                    }
                }
            }
        },
        "max_millis": 50,
        "file": {
            "module": "permission"
        }
    }
]
