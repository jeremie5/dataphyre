[
    {
        "name": "snapshot_captures_allowed_and_denied_permissions",
        "function": "snapshot",
        "class": "dataphyre\\permission",
        "static_method": true,
        "args": [
            {
                "permissions": [
                    "panel.orders.view_any"
                ]
            },
            [
                "panel.orders.view_any",
                "panel.orders.update"
            ]
        ],
        "expected": {
            "assert": {
                "type": "array",
                "paths": {
                    "allowed": {
                        "contains": [
                            "panel.orders.view_any"
                        ]
                    },
                    "denied": {
                        "contains": [
                            "panel.orders.update"
                        ]
                    }
                }
            }
        },
        "max_millis": 50,
        "file": {
            "module": "permission"
        }
    },
    {
        "name": "diff_snapshots_reports_effective_grants",
        "function": "diffSnapshots",
        "class": "dataphyre\\permission",
        "static_method": true,
        "args": [
            {
                "decisions": {
                    "panel.orders.view_any": true,
                    "panel.orders.update": false
                },
                "roles": [],
                "rules": [
                    "panel.orders.view_any"
                ]
            },
            {
                "decisions": {
                    "panel.orders.view_any": true,
                    "panel.orders.update": true
                },
                "roles": [],
                "rules": [
                    "panel.orders.*"
                ]
            }
        ],
        "expected": {
            "assert": {
                "type": "array",
                "paths": {
                    "ok": {
                        "same": false
                    },
                    "granted": {
                        "contains": [
                            "panel.orders.update"
                        ]
                    },
                    "rule_changes/added": {
                        "contains": [
                            "panel.orders.*"
                        ]
                    }
                }
            }
        },
        "max_millis": 50,
        "file": {
            "module": "permission"
        }
    }
]
