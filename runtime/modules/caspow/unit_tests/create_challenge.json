[
    {
        "name": "create_challenge returns signed challenge envelope",
        "function": "create_challenge",
        "class": "dataphyre\\caspow",
        "static_method": true,
        "args": [
            "unit_test_login",
            {
                "hardware_concurrency": 8,
                "device_memory": 8,
                "save_data": false,
                "reduced_motion": false
            }
        ],
        "expected": {
            "assert": {
                "type": "array",
                "paths": {
                    "version": {
                        "same": "2"
                    },
                    "challenge_id": {
                        "not_empty": true
                    },
                    "nonce": {
                        "not_empty": true
                    },
                    "algorithm": {
                        "same": "SHA-256"
                    },
            "difficulty_bits": {
                "exists": true,
                "not_same": null
            },
            "issued_at": {
                "exists": true,
                "not_same": null
            },
            "expires_at": {
                "exists": true,
                "not_same": null
            },
            "signature": {
                "exists": true,
                "not_same": null
                    },
                    "scope": {
                        "same": "unit_test_login"
                    }
                },
                "compare": [
                    {
                        "left": "expires_at",
                        "operator": "greater_than",
                        "right": "issued_at"
                    }
                ]
            }
        },
        "dependencies": {
            "class": [
                "dataphyre\\caspow"
            ],
            "function": [
                "dpvk"
            ]
        },
        "max_millis": 20
    }
]
