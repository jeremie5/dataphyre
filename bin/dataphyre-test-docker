#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
dockerfile="$root/docker/testing/Dockerfile"
image=${DATAPHYRE_TEST_IMAGE:-dataphyre-test:php8.4}
parent_memory=${DATAPHYRE_TEST_PARENT_MEMORY:-4G}
engine=${DATAPHYRE_TEST_ENGINE:-auto}
coverage=0
required_engine=''
changed=0
container_root=${DATAPHYRE_TEST_CONTAINER_ROOT:-0}

case "$container_root" in
	0|1) ;;
	*) echo 'DATAPHYRE_TEST_CONTAINER_ROOT must be 0 or 1.' >&2; exit 2 ;;
esac

for argument in "$@"; do
	case "$argument" in
		--coverage|--coverage=*) coverage=1 ;;
		--coverage-require=*) required_engine=${argument#--coverage-require=} ;;
		--changed|--changed=*) changed=1 ;;
	esac
done

git_root=$root
git_prefix=''
if [ "$changed" -eq 1 ] && command -v git >/dev/null 2>&1; then
	discovered_git_root=$(git -C "$root" rev-parse --show-toplevel 2>/dev/null || true)
	if [ -n "$discovered_git_root" ] && [ "$discovered_git_root" != "$root" ]; then
		git_root=$discovered_git_root
		git_prefix=$(git -C "$root" rev-parse --show-prefix 2>/dev/null || true)
	fi
fi

if [ "$engine" = auto ]; then
	case "$required_engine" in
		xdebug) engine=xdebug ;;
		included_files) engine=php ;;
		phpdbg) engine=phpdbg ;;
		'') if [ "$coverage" -eq 1 ]; then engine=phpdbg; else engine=php; fi ;;
		*) echo "Unsupported coverage engine: $required_engine" >&2; exit 2 ;;
	esac
fi

case "$engine" in
	php|phpdbg|xdebug) ;;
	*) echo 'DATAPHYRE_TEST_ENGINE must be auto, php, phpdbg, or xdebug.' >&2; exit 2 ;;
esac

if [ "${DATAPHYRE_TEST_SKIP_BUILD:-0}" != 1 ]; then
	docker build --file "$dockerfile" --tag "$image" "$root"
fi

uid=$(id -u)
gid=$(id -g)

if [ "$engine" = xdebug ]; then
	xdebug_mode=coverage
	php_ini_scan_dir=/usr/local/etc/php/conf.d:/usr/local/etc/php-xdebug.d
	set -- php -d "memory_limit=$parent_memory" bin/dataphyre-test "$@"
elif [ "$engine" = phpdbg ]; then
	xdebug_mode=off
	php_ini_scan_dir=/usr/local/etc/php/conf.d
	set -- phpdbg -d "memory_limit=$parent_memory" -qrr bin/dataphyre-test "$@"
else
	xdebug_mode=off
	php_ini_scan_dir=/usr/local/etc/php/conf.d
	set -- php -d "memory_limit=$parent_memory" bin/dataphyre-test "$@"
fi

if [ "${DATAPHYRE_TEST_WRITABLE_SOURCE:-0}" = 1 ]; then
	if [ "$container_root" -eq 1 ]; then
		echo 'DATAPHYRE_TEST_CONTAINER_ROOT requires the default read-only source mount.' >&2
		exit 2
	fi
	if [ "$git_root" != "$root" ]; then
		exec docker run --rm --init \
			--user "$uid:$gid" \
			--env HOME=/tmp/dataphyre-test-home \
			--env "XDEBUG_MODE=$xdebug_mode" \
			--env "PHP_INI_SCAN_DIR=$php_ini_scan_dir" \
			--env DATAPHYRE_TEST_GIT_ROOT=/workspace/repository \
			--env "DATAPHYRE_TEST_GIT_PREFIX=$git_prefix" \
			--mount "type=bind,source=$git_root,target=/workspace/repository,readonly" \
			--mount "type=bind,source=$root,target=/workspace/dataphyre" \
			--workdir /workspace/dataphyre \
			"$image" "$@"
	fi
	exec docker run --rm --init \
		--user "$uid:$gid" \
		--env HOME=/tmp/dataphyre-test-home \
		--env "XDEBUG_MODE=$xdebug_mode" \
		--env "PHP_INI_SCAN_DIR=$php_ini_scan_dir" \
		--mount "type=bind,source=$root,target=/workspace/dataphyre" \
		--workdir /workspace/dataphyre \
		"$image" "$@"
fi

if [ "$container_root" -eq 1 ]; then
	# The read-only source bind must contain the writable cache mountpoint.
	mkdir -p "$root/cache"
	if [ "$engine" = xdebug ]; then
		root_cache_flag=--mount
		root_cache_value="type=bind,source=$root/cache,target=/workspace/dataphyre/cache"
	else
		root_cache_flag=--tmpfs
		root_cache_value=/workspace/dataphyre/cache:rw,nosuid,nodev
	fi
	if [ "$git_root" != "$root" ]; then
		exec docker run --rm --init \
			--user 0:0 \
			--network none \
			--env HOME=/tmp/dataphyre-test-home \
			--env "DATAPHYRE_TEST_SOURCE_UID=$uid" \
			--env "DATAPHYRE_TEST_SOURCE_GID=$gid" \
			--env "XDEBUG_MODE=$xdebug_mode" \
			--env "PHP_INI_SCAN_DIR=$php_ini_scan_dir" \
			--env DATAPHYRE_TEST_CONTAINER_ROOT=1 \
			--env DATAPHYRE_TEST_GIT_ROOT=/workspace/repository \
			--env "DATAPHYRE_TEST_GIT_PREFIX=$git_prefix" \
			--mount "type=bind,source=$git_root,target=/workspace/repository,readonly" \
			--mount "type=bind,source=$root,target=/workspace/dataphyre,readonly" \
			"$root_cache_flag" "$root_cache_value" \
			--workdir /workspace/dataphyre \
			"$image" sh -c '
				status=0
				"$@" || status=$?
				chown -R "$DATAPHYRE_TEST_SOURCE_UID:$DATAPHYRE_TEST_SOURCE_GID" /workspace/dataphyre/cache || status=1
				exit "$status"
			' dataphyre-test-root "$@"
	fi
	exec docker run --rm --init \
		--user 0:0 \
		--network none \
		--env HOME=/tmp/dataphyre-test-home \
		--env "DATAPHYRE_TEST_SOURCE_UID=$uid" \
		--env "DATAPHYRE_TEST_SOURCE_GID=$gid" \
		--env "XDEBUG_MODE=$xdebug_mode" \
		--env "PHP_INI_SCAN_DIR=$php_ini_scan_dir" \
		--env DATAPHYRE_TEST_CONTAINER_ROOT=1 \
		--mount "type=bind,source=$root,target=/workspace/dataphyre,readonly" \
		"$root_cache_flag" "$root_cache_value" \
		--workdir /workspace/dataphyre \
		"$image" sh -c '
			status=0
			"$@" || status=$?
			chown -R "$DATAPHYRE_TEST_SOURCE_UID:$DATAPHYRE_TEST_SOURCE_GID" /workspace/dataphyre/cache || status=1
			exit "$status"
		' dataphyre-test-root "$@"
fi
# Test source is immutable by default. Persistent runner indexes and reports
# remain writable under cache/, while test-owned disposable files live in the
# container's /tmp through TestKit workspaces and ROOTPATH sandboxes.
mkdir -p "$root/cache"
if [ "$git_root" != "$root" ]; then
	exec docker run --rm --init \
		--user "$uid:$gid" \
		--env HOME=/tmp/dataphyre-test-home \
		--env "XDEBUG_MODE=$xdebug_mode" \
		--env "PHP_INI_SCAN_DIR=$php_ini_scan_dir" \
		--env DATAPHYRE_TEST_GIT_ROOT=/workspace/repository \
		--env "DATAPHYRE_TEST_GIT_PREFIX=$git_prefix" \
		--mount "type=bind,source=$git_root,target=/workspace/repository,readonly" \
		--mount "type=bind,source=$root,target=/workspace/dataphyre,readonly" \
		--mount "type=bind,source=$root/cache,target=/workspace/dataphyre/cache" \
		--workdir /workspace/dataphyre \
		"$image" "$@"
fi
exec docker run --rm --init \
	--user "$uid:$gid" \
	--env HOME=/tmp/dataphyre-test-home \
	--env "XDEBUG_MODE=$xdebug_mode" \
	--env "PHP_INI_SCAN_DIR=$php_ini_scan_dir" \
	--mount "type=bind,source=$root,target=/workspace/dataphyre,readonly" \
	--mount "type=bind,source=$root/cache,target=/workspace/dataphyre/cache" \
	--workdir /workspace/dataphyre \
	"$image" "$@"
